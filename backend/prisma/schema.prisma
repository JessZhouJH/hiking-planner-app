/** Model Definition **/

// 1. Access Control: User, Role, Permission, UserRole, RolePermission
model User {
  id  Int @id @default(autoincrement())
  name String
  email String @unique
  password_hash String?
  avatar_key String?

  notes String?
  status Status @default(ACTIVE)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  created_by_id Int
  updated_by_id Int
}

model Role {
  id Int@id @default(autoincrement())
  name String @unique
  
  notes String?
  status Status @default(ACTIVE)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  created_by_id Int
  updated_by_id Int
}

model Permission {
  id Int@id @default(autoincrement())
  name String@unique

  notes String?
  status Status @default(ACTIVE)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  created_by_id Int
  updated_by_id Int
}

model UserRole {
  id Int@id @default(autoincrement())
  user_id Int
  role_id Int

  notes String?
  status StatusRBAC @default(ACTIVE)

  granted_at DateTime @default(now())
  revoked_at DateTime?
  granted_by_id Int
  revoked_by_id Int?
}

model RolePermission {
  id Int@id @default(autoincrement())
  role_id Int
  permission_id Int

  notes String?
  status StatusRBAC @default(ACTIVE)

  granted_at DateTime @default(now())
  revoked_at DateTime?
  granted_by_id Int
  revoked_by_id Int?

  @@unique([role_id, permission_id])
}

// 2. Common: Alias, Attachment, Unit, Media
model Alias{
  id Int @id@default(autoincrement())
  target_type TargetType
  target_id Int
  alias String

  notes String?
  status Status @default(ACTIVE)

  created_at DateTime @default(now())
  created_by_id Int
  updated_at DateTime @updatedAt
  updated_by_id Int

  @@unique([target_type, target_id, alias])
}

model Attachment{
  id Int @id@default(autoincrement())
  attach_to_type TargetType
  attach_to_id Int
  media_id Int?
  attachment_type AttachmentType

  notes String?
  status Status @default(ACTIVE)

  uploaded_at DateTime @default(now())
  uploaded_by_id Int
  updated_at DateTime @updatedAt
  updated_by_id Int
}

model Media {
  id Int @id@default(autoincrement())
  media_key String @unique

  status Status @default(ACTIVE)

  created_at DateTime @default(now())
  created_by_id Int
  updated_at DateTime @updatedAt
  updated_by_id Int
}

model Unit{
  id Int @id@default(autoincrement())
  name String
  display_name String
  symbol String?
  category UnitCategory
  
  is_base Boolean @default(false)
  scale_to_base Float?
  offset_to_base Float?

  notes String?
  status Status @default(ACTIVE)

  created_at DateTime @default(now())
  created_by_id Int
  updated_at DateTime @updatedAt
  updated_by_id Int
}

// 3. Gear Module
model Brand {
