/** Model Definition **/

// 1. Access Control: User, Role, Permission, UserRole, RolePermission
model User {
  id  Int @id @default(autoincrement())
  name String
  email String @unique
  password_hash String?
  avatar_key String?

  notes String?
  status Status @default(ACTIVE)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  created_by_id Int?
  updated_by_id Int?

  // Self-referencing relations for created_by and updated_by
  created_by User? @relation("UserCreatedBy", fields: [created_by_id], references: [id])
  updated_by User? @relation("UserUpdatedBy", fields: [updated_by_id], references: [id])

  users__created_by User[] @relation("UserCreatedBy")
  users__updated_by User[] @relation("UserUpdatedBy")

  /** Foreign key relations for:
        - created/updated/granted/revoked/verified/reviewed_by_id
        - requested/resolved_by_id
        - owner/user/contributor_id 
      in other models
  **/
  // Access Control Module
  roles__created_by Role[] @relation("RoleCreatedBy")
  roles__updated_by Role[] @relation("RoleUpdatedBy")

  permissions__created_by Permission[] @relation("PermissionCreatedBy")
  permissions__updated_by Permission[] @relation("PermissionUpdatedBy")

  user_roles_granted_by UserRole[] @relation("UserRoleGrantedBy")
  user_roles_revoked_by UserRole[] @relation("UserRoleRevokedBy")
  user_role__user UserRole[] @relation("UserRoleUser")

  role_permission_granted_by RolePermission[] @relation("RolePermissionGrantedBy")
  role_permission_revoked_by RolePermission[] @relation("RolePermissionRevokedBy")

  // Common Module
  alias__created_by Alias[] @relation("AliasCreatedBy")
  alias__updated_by Alias[] @relation("AliasUpdatedBy")

  media_archive__created_by MediaArchive[] @relation("MediaArchiveCreatedBy")
  media_archive__updated_by MediaArchive[] @relation("MediaArchiveUpdatedBy")
  media_archive__reviewed_by MediaArchive[] @relation("MediaArchiveReviewedBy")
  media_archive__contributor MediaArchive[] @relation("MediaArchiveContributor")

  attachement__created_by Attachment[] @relation("AttachmentCreatedBy")
  attachement__updated_by Attachment[] @relation("AttachmentUpdatedBy")
