  verified_at DateTime?
  verified_by_id Int?
}

model GearSpecsDefinition {
  id Int @id @default(autoincrement())
  name String
  gear_type_id Int
  value_type ValueType
  default_unit_id Int?

  is_critical Boolean @default(false)
  is_variant_sensitive Boolean @default(false)

  notes String?
  status Status @default(ACTIVE)

  created_at DateTime @default(now())
  created_by_id Int
  updated_at DateTime @updatedAt
  updated_by_id Int

  @@unique([gear_type_id, name])
}

model GearSpecs {
  id Int @id @default(autoincrement())
  gear_id Int
  gear_variant_id Int?
  gear_specs_definition_id Int

  source_unit_id Int?
  value_boolean Boolean?
  value_text String?
  value_numeric_1 Float?
  value_numeric_2 Float?
  operator Operator?

  notes String?
  status Status @default(ACTIVE)
  
  created_at DateTime @default(now())
  created_by_id Int
  updated_at DateTime @updatedAt
  updated_by_id Int

  @@unique([gear_id, gear_variant_id, gear_specs_definition_id])
}

model GearFeature {
  id Int @id @default(autoincrement())
  gear_id Int
  gear_variant_id Int?
  name String?
  description String?

  notes String?
  status Status @default(ACTIVE)

  created_at DateTime @default(now())
  created_by_id Int
  updated_at DateTime @updatedAt
  updated_by_id Int

  // TODO: add constraint check in Postgres migration to ensure that either name or description is not null
}

model GearVariant {
  id Int @id @default(autoincrement())
  gear_id Int
  gear_variant_name String
