// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Enums and constants
enum Status{
  ACTIVE
  PENDING
  INACTIVE
  ARCHIVED
}

enum StatusRBAC{
  ACTIVE
  ARCHIVED
}

model User {
  id  Int @id @default(autoincrement())
  name String
  email String @unique
  password_hash String?
  avatar_key String?

  notes String?
  status Status @default(ACTIVE)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  created_by_id Int
  updated_by_id Int
}

model Role {
  id Int@id @default(autoincrement())
  name String @unique
  
  notes String?
  status Status @default(ACTIVE)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  created_by_id Int
  updated_by_id Int
}

model Permission {
  id Int@id @default(autoincrement())
  name String@unique

  notes String?
  status Status @default(ACTIVE)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  created_by_id Int
  updated_by_id Int
}

model UserRole {
  id Int@id @default(autoincrement())
  user_id Int
  role_id Int

  notes String?
  status StatusRBAC @default(ACTIVE)

  granted_at DateTime @default(now())
  revoked_at DateTime?
  granted_by_id Int
  revoked_by_id Int?
}

model RolePermission {
  id Int@id @default(autoincrement())
  role_id Int
  permission_id Int

  notes String?
  status StatusRBAC @default(ACTIVE)

  granted_at DateTime @default(now())
  revoked_at DateTime?
  granted_by_id Int
  revoked_by_id Int?
}